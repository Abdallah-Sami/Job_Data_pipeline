# Copy to .env for local runs and fill in. Never commit the real .env.
# In Azure, set these as Container Apps Job secrets / environment variables.

# ---- All scrapers ----
AZURE_STORAGE_CONNECTION=
# Date used in output file names (defaults to today)
RUN_DATE=

# ---- Sabbar ----
MAX_JOBS_PER_RUN=900

# ---- Wuzzuf ----
MAX_JOBS=150
MAX_PAGES=0

# ---- Tanqeeb (0 = no limit for MAX_JOBS_PER_RUN) ----
# MAX_JOBS_PER_RUN=100
# MAX_PAGES=1000
STOP_AFTER_CONSECUTIVE_KNOWN_PAGES=80

# ---- Proxy (Sabbar and Tanqeeb; off by default) ----
PROXY_ENABLED=false
PROXY_HOST=
PROXY_PORT=
PROXY_USER=
PROXY_PASS=
